# Copy this file to .env.local and fill in values there. Never commit .env.local.
# This example file holds no real values.

# mock (default when unset) or live. Read only on the server.
AI_MODE=mock

# Which canned reply mock mode returns (used from ticket 01 on):
# success | bad_output | timeout | rate_limited | refusal
AI_MOCK_SCENARIO=success

# Your Anthropic key goes in .env.local only (needed from ticket 03 on).
ANTHROPIC_API_KEY=
